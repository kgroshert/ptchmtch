{
  "name": "ptchmtch",
  "version": "0.1.0",
  "private": true,
  "description": "Sing along with a MusicXML score and see how close your pitch was",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "LAN=1 vite --port 5443",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sample": "node scripts/make-sample.mjs",
    "check": "tsx scripts/check-messa.ts && tsx scripts/check-glide.ts"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^2.2.1",
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
